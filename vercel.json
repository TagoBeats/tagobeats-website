{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/travel",
      "destination": "https://tagobeats-travel.vercel.app/"
    },
    {
      "source": "/travel/:path*",
      "destination": "https://tagobeats-travel.vercel.app/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/free",
      "destination": "/#tb-plugins",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.tagobeats.com" }],
      "destination": "https://tagobeats.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tagobeats.com" }],
      "destination": "https://tagobeats.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://assets.moonbase.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.moonbase.sh; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://assets.moonbase.sh data:; connect-src 'self' https://unpkg.com https://tagobeats.moonbase.sh https://assets.moonbase.sh; frame-src 'self' https://player.beatstars.com https://tagobeats.moonbase.sh; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|webp|avif|woff2|mp3)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/((?!uploads_opt|fonts|js).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=300" }
      ]
    }
  ]
}
